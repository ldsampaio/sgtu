# SGTU backend — variáveis de ambiente
# NUNCA versionar o .env real. Os defaults de dev abaixo são inseguros de
# propósito; o gate SEC-02 recusa boot com NODE_ENV=production enquanto
# qualquer um deles estiver vazio, com 'change-me' ou com prefixo 'dev-'.

# Postgres da plataforma em dev (schemas auth/sgoa/sgrf/sgtu no mesmo banco).
DATABASE_URL="postgresql://sgrd:sgrd@localhost:5432/sgrd"

PORT=3003
FRONTEND_URL=http://localhost:5175

# Infra compartilhada (contrato de sessão — docs/session-contract.md).
# O usuário ACL saga_readonly só lê saga:sess:*:meta e saga:heartbeat;
# o SGTU nunca escreve no Redis.
REDIS_URL=redis://saga_readonly:saga-dev-ro@localhost:6379/0
SAGA_JWKS_URL=http://localhost:8000/.well-known/jwks.json
SAGA_LOGIN_URL=http://localhost:8000/login

# Allowlist de hosts que podem virar redirect em login_url (open redirect).
# Em dev, as interfaces rodam em localhost (qualquer porta).
PORTAL_ALLOWED_REDIRECT_HOSTS=localhost

# Admin do sistema (o papel ADMIN em sgtu.user_roles é atribuído a este login).
INITIAL_ADMIN_LOGIN=ldsampaio

# Anexos em disco (decisao E): nome SEMPRE hashado (sha256 do conteudo).
# Em dev, o default e <backend>/uploads (gitignored).
# UPLOADS_DIR=/var/lib/sgtu/uploads

# Servir o build do frontend na mesma origem (deploy imagem unica).
SERVE_FRONTEND=false
FRONTEND_DIST=/app/frontend-dist

LOG_LEVEL=info
